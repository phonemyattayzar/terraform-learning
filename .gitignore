# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude terraform.tfvars and *.auto.tfvars as they may contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually personal/temporary overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include plugin cache directory
.terraform.lock.hcl

# Ignore CLI configuration files
.terraformrc
terraform.rc

# OS specific files
.DS_Store
Thumbs.db
